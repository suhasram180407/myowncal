# ============================================================
# Supabase PostgreSQL (paste your values — never commit .env)
# Connection string from Supabase Dashboard -> Settings -> Database
# Use async driver: postgresql+asyncpg://...
# Example shape (replace USER, PASSWORD, HOST, DB):
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres?ssl=require
# ============================================================
DATABASE_URL=

# Supabase project (optional — for future client features)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# JWT
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI (backend only — optional)
OPENAI_API_KEY=
AI_FEATURES_ENABLED=false

# Mobile LAN API hint (not read by FastAPI)
EXPO_PUBLIC_API_URL=http://172.31.220.97:8000
